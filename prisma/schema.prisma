generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  QUEUED
  PROCESSING
  READY
  PUBLISHED
  FAILED
}

enum PublishJobStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum VideoStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

model Product {
  id               String        @id @default(cuid())
  sourceUrl        String
  sourcePlatform   String        @default("aliexpress")
  rawSourceData    Json?
  productName      String?
  shortDescription String?
  longDescription  String?
  bulletPoints     Json?         // String[]
  benefits         Json?         // String[]
  tags             Json?         // String[]
  category         String?
  costPrice        Float?
  suggestedPrice   Float?
  compareAtPrice   Float?
  status           ProductStatus @default(QUEUED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  images      ProductImage[]
  videos      ProductVideo[]
  publishJobs PublishJob[]
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  originalUrl  String
  processedUrl String?
  whiteBgUrl   String?
  isMain       Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVideo {
  id            String      @id @default(cuid())
  productId     String
  script        String?
  voiceProvider String?
  videoProvider String?
  videoUrl      String?
  caption       String?
  hashtags      Json?       // String[]
  status        VideoStatus @default(PENDING)
  variantIndex  Int         @default(0)
  createdAt     DateTime    @default(now())

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  publishJobs PublishJob[]
}

model PublishJob {
  id        String           @id @default(cuid())
  productId String
  videoId   String?
  channel   String           // "tiktok", "instagram", etc.
  payload   Json?
  status    PublishJobStatus @default(PENDING)
  result    Json?
  createdAt DateTime         @default(now())

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  video   ProductVideo? @relation(fields: [videoId], references: [id])
}

model TrendReport {
  id        String   @id @default(cuid())
  title     String
  summary   String?
  data      Json?
  createdAt DateTime @default(now())
}
