# ============================================================
# DROPSHIPPING FACTORY — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ============================================================

# --- Database ---
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dropshipping_factory"

# --- AI Text Provider (OpenAI) ---
# Required for product content generation and video script writing
OPENAI_API_KEY="sk-..."
# Optional: override model (default: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# --- Voice Provider (ElevenLabs) ---
# Required for voiceover generation
# Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=""
# Optional: override default voice ID (default: Rachel - 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# --- Image Background Removal (remove.bg) ---
# Optional: enables white background product images
# Get your key at: https://www.remove.bg/api
REMOVE_BG_API_KEY=""

# --- TikTok Publishing ---
# Required only for automated TikTok publishing
# Get via TikTok Developer Portal (Content Posting API)
TIKTOK_ACCESS_TOKEN=""

# ============================================================
# PROVIDER SWAP GUIDE
# ============================================================
# To swap providers, edit the index.ts in each provider folder:
#
#   src/providers/text/index.ts     → swap OpenAI for Anthropic, etc.
#   src/providers/voice/index.ts    → swap ElevenLabs for PlayHT, etc.
#   src/providers/video/index.ts    → swap BasicVideo for Creatomate, etc.
#   src/providers/image/index.ts    → swap BasicImage for Replicate, etc.
#   src/providers/publishing/index.ts → add Instagram, YouTube Shorts, etc.
# ============================================================
